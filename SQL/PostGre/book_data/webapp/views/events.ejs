<!DOCTYPE html>
<html>
<head>
    <title>SYS_BOOKSHOP // EVENTS</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/"><- Back to Home</a>
        <h1>Upcoming Events</h1>

        <% if (!currentCustomer) { %>
            <div class="auth-section">
                <h2>Join an Event</h2>
                <div class="auth-grid">
                    <div class="auth-box">
                        <h3>Sign In</h3>
                        <form action="/events" method="GET">
                            <select name="customerId" onchange="this.form.submit()">
                                <option value="">Select your account</option>
                                <% customers.forEach(c => { %>
                                    <option value="<%= c.id %>"><%= c.first_name %> <%= c.last_name %></option>
                                <% }) %>
                            </select>
                        </form>
                    </div>
                    <div class="auth-box">
                        <h3>New Member</h3>
                        <form action="/register" method="POST">
                            <input type="text" name="first_name" placeholder="First Name" required>
                            <input type="text" name="last_name" placeholder="Last Name" required>
                            <input type="email" name="email" placeholder="Email Address" required>
                            <button type="submit">Join & Attend</button>
                        </form>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="logged-in-bar">
                <span>Active Session: <%= currentCustomer.first_name %> <%= currentCustomer.last_name %></span>
                <a href="/events" style="color: inherit; text-decoration: underline;">Switch Account</a>
            </div>
        <% } %>
        
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <h2>Store Events</h2>
            <div style="font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 1px;">
                * System dashboard: Live Attendance Tracks
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th style="text-align: center;">Registrations</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% if (events.length === 0) { %>
                    <tr><td colspan="5" style="text-align: center; color: #888; padding: 40px;">No upcoming events at this time.</td></tr>
                <% } %>
                <% events.forEach(e => { %>
                    <tr>
                        <td style="font-weight: 600;"><%= e.name %></td>
                        <td><%= e.event_date.toDateString() %></td>
                        <td><%= e.location %></td>
                        <td style="text-align: center;">
                            <span style="background: <%= e.reg_count > 10 ? 'var(--secondary)' : 'var(--background)' %>; padding: 2px 10px; border-radius: 12px; font-weight: 600;">
                                <%= e.reg_count %>
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <% if (currentCustomer) { %>
                                <form action="/events/register" method="POST">
                                    <input type="hidden" name="event_id" value="<%= e.id %>">
                                    <input type="hidden" name="customer_id" value="<%= currentCustomer.id %>">
                                    <button type="submit">Reserve Spot</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <h2>Attendance History</h2>
        <table>
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Member</th>
                    <th>Registered On</th>
                </tr>
            </thead>
            <tbody>
                <% registrations.forEach(reg => { %>
                    <tr>
                        <td><%= reg.event_name %></td>
                        <td><%= reg.first_name %> <%= reg.last_name %></td>
                        <td style="font-size: 0.8em; color: #888;"><%= reg.registered_at.toLocaleDateString() %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
        <table>
            <tr>
                <th>EVENT</th>
                <th>CUSTOMER</th>
                <th>REG_DATE</th>
            </tr>
            <% registrations.forEach(reg => { %>
                <tr>
                    <td><%= reg.event_name %></td>
                    <td><%= reg.first_name %> <%= reg.last_name %></td>
                    <td><%= reg.registered_at.toLocaleDateString() %></td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>
