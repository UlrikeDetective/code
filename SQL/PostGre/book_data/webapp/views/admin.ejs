<!DOCTYPE html>
<html>
<head>
    <title>SYS_BOOKSHOP // BACKEND</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/">[BACK_TO_HOME]</a>
        <h1>SYSTEM_BACKEND</h1>
        
        <h2>Customer Database</h2>
        <table>
            <tr>
                <th>ID</th>
                <th>NAME</th>
                <th>EMAIL</th>
            </tr>
            <% customers.forEach(c => { %>
                <tr>
                    <td>#<%= c.id %></td>
                    <td><%= c.first_name %> <%= c.last_name %></td>
                    <td><%= c.email %></td>
                </tr>
            <% }) %>
        </table>

        <div style="display: flex; gap: 20px;">
            <div style="flex: 1;">
                <h2>Add New Book</h2>
                <form action="/admin/add-book" method="POST">
                    <input type="text" name="title" placeholder="TITLE" required><br>
                    <select name="author_id" required>
                        <option value="">SELECT_AUTHOR</option>
                        <% authors.forEach(a => { %>
                            <option value="<%= a.id %>"><%= a.first_name %> <%= a.last_name %></option>
                        <% }) %>
                    </select><br>
                    <select name="genre_id" required>
                        <option value="">SELECT_GENRE</option>
                        <% genres.forEach(g => { %>
                            <option value="<%= g.id %>"><%= g.name %></option>
                        <% }) %>
                    </select><br>
                    <input type="number" step="0.01" name="price" placeholder="PRICE" required><br>
                    <input type="number" name="stock" placeholder="STOCK" required><br>
                    <input type="number" name="pages" placeholder="PAGES"><br>
                    <input type="number" name="year" placeholder="RELEASED_YEAR"><br>
                    <button type="submit">[ADD_BOOK]</button>
                </form>
            </div>
            <div style="flex: 1;">
                <h2>Add New Event</h2>
                <form action="/admin/add-event" method="POST">
                    <input type="text" name="name" placeholder="EVENT_NAME" required><br>
                    <input type="datetime-local" name="date" required><br>
                    <input type="text" name="location" placeholder="LOCATION"><br>
                    <textarea name="description" placeholder="DESCRIPTION"></textarea><br>
                    <button type="submit">[ADD_EVENT]</button>
                </form>
            </div>
        </div>

        <h2>Order Headers</h2>
        <table>
            <tr>
                <th>ORDER_ID</th>
                <th>CUSTOMER_EMAIL</th>
                <th>DATE</th>
                <th>TOTAL</th>
            </tr>
            <% orders.forEach(o => { %>
                <tr>
                    <td>ID_<%= o.id %></td>
                    <td><%= o.email %></td>
                    <td><%= o.order_date.toLocaleDateString() %></td>
                    <td>$<%= o.total_amount %></td>
                </tr>
            <% }) %>
        </table>

        <h2>Order Items Detail</h2>
        <table>
            <tr>
                <th>ORDER_REF</th>
                <th>BOOK_TITLE</th>
                <th>QTY</th>
                <th>UNIT_PRICE</th>
            </tr>
            <% items.forEach(i => { %>
                <tr>
                    <td>#<%= i.order_id %></td>
                    <td><%= i.title %></td>
                    <td><%= i.quantity %></td>
                    <td>$<%= i.unit_price %></td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>
