<!DOCTYPE html>
<html>
<head>
    <title>SYS_BOOKSHOP // BACKEND</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/">[BACK_TO_HOME]</a>
        <h1>SYSTEM_BACKEND</h1>
        
        <div style="display: flex; gap: 40px; margin-bottom: 40px; border-bottom: 1px dashed #00ff41; padding-bottom: 20px;">
            <div style="flex: 1;">
                <h2 style="font-size: 1.8em; color: #fff; text-shadow: 0 0 5px #00ff41;">ADD NEW BOOK</h2>
                <form action="/admin/add-book" method="POST">
                    <input type="text" name="title" placeholder="TITLE" required style="width: 100%; margin-bottom: 10px;"><br>
                    <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                        <input type="text" name="author_first_name" placeholder="AUTHOR_FIRST_NAME" required style="flex: 1;">
                        <input type="text" name="author_last_name" placeholder="AUTHOR_LAST_NAME" required style="flex: 1;">
                    </div>
                    <input type="text" name="genre_name" placeholder="GENRE" required style="width: 100%; margin-bottom: 10px;"><br>
                    <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                        <input type="number" step="0.01" name="price" placeholder="PRICE" required style="flex: 1;">
                        <input type="number" name="stock" placeholder="STOCK" required style="flex: 1;">
                    </div>
                    <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                        <input type="number" name="pages" placeholder="PAGES" style="flex: 1;">
                        <input type="number" name="year" placeholder="YEAR" style="flex: 1;">
                    </div>
                    <button type="submit" style="width: 100%; padding: 10px; font-weight: bold;">[EXECUTE_ADD_BOOK]</button>
                </form>
            </div>
            <div style="flex: 1;">
                <h2 style="font-size: 1.8em; color: #fff; text-shadow: 0 0 5px #00ff41;">ADD NEW EVENT</h2>
                <form action="/admin/add-event" method="POST">
                    <input type="text" name="name" placeholder="EVENT_NAME" required style="width: 100%; margin-bottom: 10px;"><br>
                    <input type="datetime-local" name="date" required style="width: 100%; margin-bottom: 10px;"><br>
                    <input type="text" name="location" placeholder="LOCATION" style="width: 100%; margin-bottom: 10px;"><br>
                    <textarea name="description" placeholder="DESCRIPTION" style="width: 100%; height: 60px; margin-bottom: 10px;"></textarea><br>
                    <button type="submit" style="width: 100%; padding: 10px; font-weight: bold;">[EXECUTE_ADD_EVENT]</button>
                </form>
            </div>
        </div>

        <h2>Customer Database</h2>
        <table>
            <tr>
                <th>ID</th>
                <th>NAME</th>
                <th>EMAIL</th>
            </tr>
            <% customers.forEach(c => { %>
                <tr>
                    <td>#<%= c.id %></td>
                    <td><%= c.first_name %> <%= c.last_name %></td>
                    <td><%= c.email %></td>
                </tr>
            <% }) %>
        </table>

        <h2>Order Headers</h2>
        <table>
            <tr>
                <th>ORDER_ID</th>
                <th>CUSTOMER_EMAIL</th>
                <th>DATE</th>
                <th>TOTAL</th>
            </tr>
            <% orders.forEach(o => { %>
                <tr>
                    <td>ID_<%= o.id %></td>
                    <td><%= o.email %></td>
                    <td><%= o.order_date.toLocaleDateString() %></td>
                    <td>$<%= o.total_amount %></td>
                </tr>
            <% }) %>
        </table>

        <h2>Order Items Detail</h2>
        <table>
            <tr>
                <th>ORDER_REF</th>
                <th>BOOK_TITLE</th>
                <th>QTY</th>
                <th>UNIT_PRICE</th>
            </tr>
            <% items.forEach(i => { %>
                <tr>
                    <td>#<%= i.order_id %></td>
                    <td><%= i.title %></td>
                    <td><%= i.quantity %></td>
                    <td>$<%= i.unit_price %></td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>
