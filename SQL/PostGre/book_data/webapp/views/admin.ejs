<!DOCTYPE html>
<html>
<head>
    <title>SYS_BOOKSHOP // BACKEND</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/">[BACK_TO_HOME]</a>
        <h1>SYSTEM_BACKEND</h1>
        
        <h2>Customer Database</h2>
        <table>
            <tr>
                <th>ID</th>
                <th>NAME</th>
                <th>EMAIL</th>
            </tr>
            <% customers.forEach(c => { %>
                <tr>
                    <td>#<%= c.id %></td>
                    <td><%= c.first_name %> <%= c.last_name %></td>
                    <td><%= c.email %></td>
                </tr>
            <% }) %>
        </table>

        <h2>Order Headers</h2>
        <table>
            <tr>
                <th>ORDER_ID</th>
                <th>CUSTOMER_EMAIL</th>
                <th>DATE</th>
                <th>TOTAL</th>
            </tr>
            <% orders.forEach(o => { %>
                <tr>
                    <td>ID_<%= o.id %></td>
                    <td><%= o.email %></td>
                    <td><%= o.order_date.toLocaleDateString() %></td>
                    <td>$<%= o.total_amount %></td>
                </tr>
            <% }) %>
        </table>

        <h2>Order Items Detail</h2>
        <table>
            <tr>
                <th>ORDER_REF</th>
                <th>BOOK_TITLE</th>
                <th>QTY</th>
                <th>UNIT_PRICE</th>
            </tr>
            <% items.forEach(i => { %>
                <tr>
                    <td>#<%= i.order_id %></td>
                    <td><%= i.title %></td>
                    <td><%= i.quantity %></td>
                    <td>$<%= i.unit_price %></td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>
