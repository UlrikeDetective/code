<!DOCTYPE html>
<html>
<head>
    <title>SYS_BOOKSHOP // MY_REVIEWS</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/"><- Back to Home</a>
        <h1>Reading Journal</h1>

        <% if (!currentCustomer) { %>
            <div class="auth-section">
                <h2>Share your thoughts</h2>
                <div class="auth-box">
                    <h3>Select your account to view purchases</h3>
                    <form action="/reviews" method="GET">
                        <select name="customerId" onchange="this.form.submit()">
                            <option value="">Select account</option>
                            <% customers.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.first_name %> <%= c.last_name %></option>
                            <% }) %>
                        </select>
                    </form>
                </div>
            </div>
        <% } else { %>
            <div class="logged-in-bar">
                <span>Active Session: <%= currentCustomer.first_name %> <%= currentCustomer.last_name %></span>
                <a href="/reviews" style="color: inherit; text-decoration: underline;">Switch Account</a>
            </div>

            <div class="shop-layout">
                <div class="column-left" style="flex: 1;">
                    <h2>Purchased Books</h2>
                    <% if (boughtBooks.length === 0) { %>
                        <p style="color: #666;">You haven't purchased any books yet.</p>
                        <a href="/shop?customerId=<%= currentCustomer.id %>">Visit the shop to browse books.</a>
                    <% } else { %>
                        <table>
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Author</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% boughtBooks.forEach(book => { %>
                                    <tr>
                                        <td style="font-weight: 600;"><%= book.title %></td>
                                        <td><%= book.first_name %> <%= book.last_name %></td>
                                        <td style="text-align: right;">
                                            <% if (book.existing_rating) { %>
                                                <span style="color: var(--accent); font-weight: 600;"><%= book.existing_rating %>/5 Rated</span>
                                            <% } else { %>
                                                <button onclick="document.getElementById('review-form-<%= book.id %>').style.display='block'">Write Review</button>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% if (book.existing_rating) { %>
                                        <tr>
                                            <td colspan="3" style="font-size: 0.9em; padding-top: 0; color: #666; font-style: italic;">
                                                "<%= book.existing_comment %>"
                                            </td>
                                        </tr>
                                    <% } %>
                                    <tr id="review-form-<%= book.id %>" style="display: none;">
                                        <td colspan="3" style="background: var(--background); padding: 25px;">
                                            <form action="/shop/review" method="POST">
                                                <input type="hidden" name="customer_id" value="<%= currentCustomer.id %>">
                                                <input type="hidden" name="book_id" value="<%= book.id %>">
                                                <div style="margin-bottom: 15px;">
                                                    <label style="font-weight: 600; display: block; margin-bottom: 5px;">Rating</label>
                                                    <select name="rating" required>
                                                        <option value="5">5/5 - Perfect</option>
                                                        <option value="4">4/5 - Very Good</option>
                                                        <option value="3">3/5 - Good</option>
                                                        <option value="2">2/5 - Fair</option>
                                                        <option value="1">1/5 - Poor</option>
                                                    </select>
                                                </div>
                                                <div style="margin-bottom: 15px;">
                                                    <label style="font-weight: 600; display: block; margin-bottom: 5px;">Your Review</label>
                                                    <textarea name="comment" placeholder="What did you think of this book?" required style="height: 100px;"></textarea>
                                                </div>
                                                <div style="display: flex; gap: 10px;">
                                                    <button type="submit">Publish Review</button>
                                                    <button type="button" onclick="this.parentElement.parentElement.parentElement.parentElement.style.display='none'" style="background: #ccc; color: #333;">Cancel</button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>
