<!DOCTYPE html>
<html>
<head>
    <title>HIGH TIDE BOOKS // SHOP</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <a href="/"><- Back to Home</a>
        <h1>High Tide Collection</h1>

        <% if (!currentCustomer) { %>
            <div class="auth-section">
                <h2>Welcome to High Tide Books</h2>
                <div class="auth-grid">
                    <div class="auth-box">
                        <h3>Sign In</h3>
                        <form action="/login" method="POST" id="loginForm">
                            <input list="customer-list" name="customerSearch" id="customerSearch" placeholder="Type your name to sign in..." autocomplete="off">
                            <datalist id="customer-list">
                                <% customers.forEach(c => { %>
                                    <option value="<%= c.first_name %> <%= c.last_name %>" data-id="<%= c.id %>"></option>
                                <% }) %>
                            </datalist>
                            <input type="hidden" name="customerId" id="customerId">
                        </form>
                        <script>
                            document.getElementById('customerSearch').addEventListener('input', function(e) {
                                const val = e.target.value;
                                const list = document.getElementById('customer-list');
                                const opts = list.options;
                                for (let i = 0; i < opts.length; i++) {
                                    if (opts[i].value === val) {
                                        document.getElementById('customerId').value = opts[i].getAttribute('data-id');
                                        document.getElementById('loginForm').submit();
                                        break;
                                    }
                                }
                            });
                        </script>
                    </div>
                    <div class="auth-box">
                        <h3>Join our Community</h3>
                        <form action="/register" method="POST">
                            <input type="text" name="first_name" placeholder="First Name" required>
                            <input type="text" name="last_name" placeholder="Last Name" required>
                            <input type="email" name="email" placeholder="Email Address" required>
                            <button type="submit">Create Account</button>
                        </form>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="logged-in-bar" style="display: flex; justify-content: space-between; align-items: center;">
                <span>Active Session: <%= currentCustomer.first_name %> <%= currentCustomer.last_name %></span>
                <form action="/logout" method="POST" style="margin: 0;">
                    <button type="submit" style="background: transparent; border: 1px solid #1d5a4d; color: #1d5a4d; padding: 5px 15px;">Logout</button>
                </form>
            </div>
        <% } %>

        <!-- SEARCH SECTION -->
        <div style="margin-bottom: 30px;">
            <form action="/shop" method="GET" style="display: flex; gap: 10px;">
                <input type="text" name="search" placeholder="Search by title, author, or genre..." value="<%= search %>" style="flex: 1;">
                <button type="submit">Search</button>
                <% if (search) { %>
                    <a href="/shop" style="line-height: 40px;">Clear</a>
                <% } %>
            </form>
        </div>
        
        <div class="shop-layout" style="display: flex; gap: 40px; margin-top: 30px;">
            <!-- Main Catalog -->
            <div class="column-left" style="flex: 2.5;">

                <% if (currentCustomer && recommendations && recommendations.length > 0) { %>
                    <div class="recommendations-section" style="background: #f0f7ff; border: 1px solid #d0e7ff; padding: 25px; border-radius: 8px; margin-bottom: 40px;">
                        <h2 style="margin-top: 0; font-size: 1.4rem; color: #0056b3;">Personalized for <%= currentCustomer.first_name %></h2>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                            <% recommendations.forEach(rec => { %>
                                <div class="rec-card" style="background: #fff; padding: 15px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); display: flex; flex-direction: column; justify-content: space-between;">
                                    <div>
                                        <div style="font-size: 0.7rem; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px;"><%= rec.reason %></div>
                                        <div style="font-weight: 600; font-size: 0.95rem; margin-bottom: 3px;"><%= rec.title %></div>
                                        <div style="font-size: 0.8rem; color: #555;"><%= rec.first_name %> <%= rec.last_name %></div>
                                        <div style="font-size: 0.7rem; color: var(--primary); margin-top: 5px;"><%= rec.hashtags %></div>
                                    </div>
                                    <div style="margin-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                                        <span style="font-weight: bold; color: var(--primary);">$<%= rec.price %></span>
                                        <form action="/shop/buy" method="POST">
                                            <input type="hidden" name="book_id" value="<%= rec.id %>">
                                            <input type="hidden" name="quantity" value="1">
                                            <button type="submit" style="padding: 4px 10px; font-size: 0.8rem;">Add</button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <h2>High Tide Collection</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% books.filter(book => book.stock_quantity > 0).forEach(book => { %>
                            <tr>
                                <td>
                                    <div style="font-weight: 600;">
                                        <%= book.title %>
                                        <% if (currentCustomer && purchasedBookIds.includes(book.id)) { %>
                                            <span style="font-size: 0.6em; background: var(--secondary); color: #1d5a4d; padding: 2px 8px; border-radius: 12px; margin-left: 8px; vertical-align: middle;">OWNED</span>
                                        <% } %>
                                    </div>
                                    <div style="font-size: 0.75em; color: #888;">
                                        <%= book.genre %>
                                        <% if (book.hashtags) { %>
                                            <span style="color: var(--primary); margin-left: 10px;"><%= book.hashtags %></span>
                                        <% } %>
                                    </div>
                                </td>
                                <td><%= book.first_name %> <%= book.last_name %></td>
                                <td style="color: var(--primary); font-weight: 600;">$<%= book.price %></td>
                                <td style="font-size: 0.9em; color: <%= book.stock_quantity < 5 ? 'var(--accent)' : '#888' %>">
                                    <%= book.stock_quantity %> left
                                </td>
                                <td style="text-align: right;">
                                    <% if (currentCustomer) { %>
                                        <form action="/shop/buy" method="POST" style="display: flex; gap: 5px; justify-content: flex-end;">
                                            <input type="hidden" name="book_id" value="<%= book.id %>">
                                            <input type="hidden" name="customer_id" value="<%= currentCustomer.id %>">
                                            <input type="number" name="quantity" value="1" min="1" max="<%= book.stock_quantity %>" style="width: 50px; margin: 0; padding: 5px;">
                                            <button type="submit" style="padding: 5px 15px;">Buy</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Community Sidebar -->
            <div class="column-right" style="flex: 1; border-left: 1px solid var(--border); padding-left: 30px;">
                <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 10px;">Community Feedback</h3>
                <% if (reviews.length === 0) { %>
                    <p style="color: #888; font-size: 0.9rem;">No reviews yet. Be the first to share your thoughts!</p>
                <% } %>
                <% reviews.slice(0, 5).forEach(rev => { %>
                    <div class="review-card" style="padding: 15px; margin-bottom: 15px; border-radius: 4px; background: #fff;">
                        <div style="font-size: 0.85rem; font-weight: 600; margin-bottom: 5px;"><%= rev.book %></div>
                        <div style="font-size: 0.8rem; font-style: italic; color: #555; margin-bottom: 8px;">"<%= rev.comment %>"</div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: #aaa; text-transform: uppercase;">
                            <span><%= rev.customer %></span>
                            <span style="color: var(--accent);"><%= rev.rating %>/5</span>
                        </div>
                    </div>
                <% }) %>
                <a href="/reviews" style="font-size: 0.8rem; color: var(--primary);">View all journal entries -></a>
            </div>
        </div>
    </div>
</body>
</html>
